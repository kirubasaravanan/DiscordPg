# Config for `docker compose up` (docs/ROADMAP.md Phase 7). Copy to .env —
# gitignored, never commit real values. Every key here matches
# docs/ARCHITECTURE.md §8; running a service directly with `uv run`
# instead of Docker uses that service's own .env (backend/.env.example,
# dashboard/.env.example, discord_bot/.env.example, ai_engine/.env.example).
#
# Not listed here: DATABASE_URL, AI_ENGINE_URL, API_BASE_URL. docker-
# compose.yml sets these itself to the right container-network hostnames
# (postgres, ai_engine, backend) — they're not meant to be overridden for
# the Docker path, only for the "run without Docker" per-service .env files.

# --- Postgres (bootstrap — read by the postgres image itself, and used to
# build the backend's DATABASE_URL in docker-compose.yml) ---
POSTGRES_USER=pgos
POSTGRES_PASSWORD=changeme-generate-a-real-random-password
POSTGRES_DB=pgos

# --- backend/ ---
DATABASE_ECHO=false

# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder, and never commit the real value.
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Document storage (docs/ARCHITECTURE.md §4.6). "local" (default) needs
# nothing further. For Cloudflare R2 (or real AWS S3 — leave
# STORAGE_S3_ENDPOINT_URL unset for that case), set STORAGE_BACKEND=s3 and
# fill in the STORAGE_S3_* keys below.
STORAGE_BACKEND=local
STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=900
STORAGE_LOCAL_PATH=./storage_data
# STORAGE_S3_BUCKET=pgos-documents
# STORAGE_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=changeme
# STORAGE_S3_SECRET_ACCESS_KEY=changeme

AI_ENGINE_TIMEOUT_SECONDS=30

# Scheduled jobs (docs/ARCHITECTURE.md §9) — optional; jobs that need a
# management channel skip posting (not an error) if this is unset.
SCHEDULER_ENABLED=true
DISCORD_MANAGEMENT_CHANNEL_ID=

# --- discord_bot/ ---
# From the Discord Developer Portal (discord.com/developers/applications) —
# create an application, add a Bot user, enable it, and copy its token
# here. Shared with backend/'s notification_service.py (same bot token
# sends outbound notifications via REST, no gateway connection needed for
# that — docs/ARCHITECTURE.md §9).
DISCORD_BOT_TOKEN=changeme

# Optional. Set to a test server's ID for instant command sync during
# development; leave unset for a global sync in production (can take up
# to an hour to propagate).
DISCORD_GUILD_ID=

# --- ai_engine/ ---
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30
