# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real credentials.

DATABASE_URL=postgresql+psycopg://pgos:changeme@localhost:5432/pgos_dev
DATABASE_ECHO=false

# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder, and never commit the real value.
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
