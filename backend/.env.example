# Copy this file to .env and fill in real values for your machine.
# .env is gitignored — never commit real credentials.

DATABASE_URL=postgresql+psycopg://pgos:changeme@localhost:5432/pgos_dev
DATABASE_ECHO=false

# Generate your own with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse this placeholder, and never commit the real value.
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Document storage (docs/ARCHITECTURE.md §4.6). "local" (default) needs
# nothing further — it writes under STORAGE_LOCAL_PATH and serves
# upload/download through this app's own /internal/storage/* routes.
STORAGE_BACKEND=local
STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=900
STORAGE_LOCAL_PATH=./storage_data
STORAGE_LOCAL_BASE_URL=http://localhost:8000

# Uncomment for Cloudflare R2 (or real AWS S3 — leave STORAGE_S3_ENDPOINT_URL
# unset for that case) and set STORAGE_BACKEND=s3 above.
# STORAGE_S3_BUCKET=pgos-documents
# STORAGE_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=changeme
# STORAGE_S3_SECRET_ACCESS_KEY=changeme

# Discord notifications (docs/ARCHITECTURE.md §9) — optional. Same token as
# discord_bot/.env's DISCORD_BOT_TOKEN. Only needed once Phase 6 wires the
# scheduled jobs that call app/services/notification_service.py.
# DISCORD_BOT_TOKEN=changeme
# DISCORD_MANAGEMENT_CHANNEL_ID=changeme
