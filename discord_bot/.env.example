# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# The backend this bot talks to — never a database connection, per
# docs/ARCHITECTURE.md §4.1.
API_BASE_URL=http://localhost:8000/api/v1

# From the Discord Developer Portal (discord.com/developers/applications) —
# create an application, add a Bot user, enable it, and copy its token here.
DISCORD_BOT_TOKEN=changeme

# Optional. Set this to your test server's ID while developing — slash
# commands sync to a single guild instantly. Leave unset for a global sync
# in production (propagates to all servers, but can take up to an hour).
# DISCORD_GUILD_ID=changeme
